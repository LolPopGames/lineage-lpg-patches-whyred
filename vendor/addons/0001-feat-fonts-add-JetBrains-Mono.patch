+    <!-- JetBrains Mono -->
+    <family customizationType="new-named-family" name="jetbrains-mono">
+      <font weight="100" style="normal">JetBrainsMono-Thin.ttf</font>
+      <font weight="100" style="italic">JetBrainsMono-ThinItalic.ttf</font>
+      <font weight="300" style="normal">JetBrainsMono-Light.ttf</font>
+      <font weight="300" style="italic">JetBrainsMono-LightItalic.ttf</font>
+      <font weight="400" style="normal">JetBrainsMono-Regular.ttf</font>
+      <font weight="400" style="italic">JetBrainsMono-Italic.ttf</font>
+      <font weight="500" style="normal">JetBrainsMono-Medium.ttf</font>
+      <font weight="500" style="italic">JetBrainsMono-MediumItalic.ttf</font>
+      <font weight="600" style="normal">JetBrainsMono-SemiBold.ttf</font>
+      <font weight="600" style="italic">JetBrainsMono-SemiBoldItalic.ttf</font>
+      <font weight="700" style="normal">JetBrainsMono-Bold.ttf</font>
+      <font weight="700" style="italic">JetBrainsMono-BoldItalic.ttf</font>
+      <font weight="800" style="normal">JetBrainsMono-ExtraBold.ttf</font>
+      <font weight="800" style="italic">JetBrainsMono-ExtraBoldItalic.ttf</font>
+      <font weight="900" style="normal">JetBrainsMono-Black.ttf</font>
+      <font weight="900" style="italic">JetBrainsMono-BlackItalic.ttf</font>
+    </family>
+    <alias name="jetbrains-mono-thin" to="jetbrains-mono" weight="200" />
+    <alias name="jetbrains-mono-light" to="jetbrains-mono" weight="300" />
+    <alias name="jetbrains-mono-regular" to="jetbrains-mono" weight="400" />
+    <alias name="jetbrains-mono-medium" to="jetbrains-mono" weight="500" />
+    <alias name="jetbrains-mono-semi-bold" to="jetbrains-mono" weight="600" />
+    <alias name="jetbrains-mono-bold" to="jetbrains-mono" weight="700" />
+    <alias name="jetbrains-mono-extra-bold" to="jetbrains-mono" weight="800" />
+    <alias name="jetbrains-mono-black" to="jetbrains-mono" weight="900" />
+
     <!-- Lato -->
     <family customizationType="new-named-family" name="lato">
         <font weight="400" style="normal">Lato-Regular.ttf</font>
