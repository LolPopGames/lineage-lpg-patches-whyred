diff --git a/prebuilt/product/etc/fonts_customization.xml b/prebuilt/product/etc/fonts_customization.xml
index 0470a70..dc2763a 100644
--- a/prebuilt/product/etc/fonts_customization.xml
+++ b/prebuilt/product/etc/fonts_customization.xml
@@ -252,6 +252,16 @@
     <alias name="op-sans-bold" to="op-sans" weight="700" />
     <alias name="op-sans-black" to="op-sans" weight="900" />
 
+    <!-- OpenDyslexic -->
+    <family customizationType="new-named-family" name="opendyslexic">
+       <font weight="400" style="normal">OpenDyslexic-Regular.otf</font>
+       <font weight="400" style="italic">OpenDyslexic-Italic.otf</font>
+       <font weight="700" style="normal">OpenDyslexic-Bold.otf</font>
+       <font weight="700" style="italic">OpenDyslexic-BoldItalic.otf</font>
+    </family>
+    <alias name="opendyslexic-regular" to="opendyslexic-sans" weight="400" />
+    <alias name="opendyslexic-bold" to="opendyslexic-sans" weight="700" />
+
     <!-- Oswald -->
     <family customizationType="new-named-family" name="oswald">
         <font weight="300" style="normal">Oswald-Light.ttf</font>
